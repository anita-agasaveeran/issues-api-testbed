# Copy to .env and fill in. .env is git-ignored — never commit real values.

# Fine-grained PAT scoped to this repo only: Issues (read & write), Metadata (read)
GITHUB_TOKEN=
GITHUB_OWNER=anita-agasaveeran
GITHUB_REPO=issues-api-testbed

# Shared secret for the GitHub webhook (X-Hub-Signature-256).
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=

# --- Optional: defaults shown ---
PORT=8000
DATABASE_URL=sqlite:///./events.db
LOG_LEVEL=INFO

# Hard cap on GET /events?limit=
EVENTS_MAX_LIMIT=200

# ETag response cache: replays cached validators upstream so unchanged list
# requests cost no GitHub rate-limit quota.
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=128
